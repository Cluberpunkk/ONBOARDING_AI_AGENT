# ---- ElevenLabs (voice) ----
# Get key: elevenlabs.io -> Profile -> API Keys
# Pick a warm female voice: elevenlabs.io/app/voice-library -> search "Hindi female"
# Copy the Voice ID from the voice's page
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_v3 / eleven_v4 cover all 9 Indian languages. eleven_multilingual_v2 covers Hindi+Tamil+English only.
ELEVENLABS_MODEL=eleven_v3
# Data-residency accounts (India/EU) MUST set their stack URL — the global URL 401s their keys:
#   India: https://api.in.residency.elevenlabs.io    EU: https://api.eu.residency.elevenlabs.io
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# Voice character (folded into the TTS cache hash — changing any regenerates clips)
ELEVENLABS_STABILITY=0.45      # lower = more expressive/human, higher = more consistent (eleven_v3: snapped to 0/0.5/1)
ELEVENLABS_SIMILARITY=0.80
ELEVENLABS_STYLE=0.35          # style exaggeration (if model supports)
ELEVENLABS_SPEED=0.93          # slightly slower reads warmer for a didi persona

# ---- Gemini (answer understanding) ----
# Get key: aistudio.google.com/apikey (use your billing-enabled project)
GEMINI_API_KEY=
PARSER_MODEL=gemini-2.5-flash

# ---- Avatar layer (fal.ai — batch generation ONLY, runtime never calls it) ----
# Get key: fal.ai/dashboard/keys. Used solely by scripts/build_avatar_clips.py.
FAL_KEY=
# false -> current behavior (still avatar + audio). Kill switch, no restart logic needed.
AVATAR_ENABLED=true
# The Google Flow source video (720x1280 portrait, 24fps)
AVATAR_BASE_VIDEO=assets/sakhi_base.mp4
# Lipsync model for the batch builder. Checked 2026-07: fal-ai/sync-lipsync ($0.70/min)
# is the cheapest for our 4-12s clips; fallbacks: fal-ai/latentsync ($0.20/clip),
# fal-ai/sync-lipsync/v2 ($3/min, higher quality). Pricing drifts — re-check before batches.
LIPSYNC_MODEL=fal-ai/sync-lipsync
# Idle avatar: static (still portrait + subtle CSS breathing, default) | video (palindrome loop)
AVATAR_IDLE_MODE=static

# ---- Conversation engine ----
# classic = deterministic fixed-order flow (default, demo-safe, byte-identical to v3)
# agentic = slot-filling dialogue: multi-slot capture, inference, barge-in, off-script KB
CONVERSATION_MODE=classic
# Live-TTS (T3) ceiling per session. 0 = off (value bank covers personalization at Rs 0).
# 40 chars on Flash v2.5 ~ Rs 0.17. Session budget is Rs 0.40 all-in.
T3_CHAR_BUDGET_PER_SESSION=0
T3_MODEL=eleven_flash_v2_5
BARGE_IN_ENABLED=true

# ---- Server ----
HOST=127.0.0.1
PORT=8010

# ---- Conversational tone (free knobs; tune by ear) ----
ACK_RATE=0.35                      # how often a plain answer earns a light ack
THINK_TIME_MS_RANGE=250-600        # voice delay before a simple reply (visual is instant)
THINK_TIME_MS_RANGE_DEEP=400-900   # after multi-slot capture / clarification
TURN_GAP_MS_RANGE=250-400          # handover pause before the mic opens
SOFT_OPENER_RATE=0.22              # "तो," / "चलिए," before a question
